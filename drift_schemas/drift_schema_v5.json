      "name": "supplier",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"supplier\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"phone\" TEXT NOT NULL, \"gstin\" TEXT NULL, \"notes\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "product",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"product\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"sku\" TEXT NULL, \"barcode\" TEXT NULL, \"category\" TEXT NULL, \"unit\" TEXT NOT NULL DEFAULT 'pcs', \"buy_price\" REAL NOT NULL DEFAULT 0.0, \"sell_price\" REAL NOT NULL DEFAULT 0.0, \"low_stock_level\" INTEGER NOT NULL DEFAULT 0, \"stock_qty\" INTEGER NOT NULL DEFAULT 0, \"supplier_id\" INTEGER NULL REFERENCES supplier (id) ON DELETE SET NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "movement",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"movement\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"product_id\" INTEGER NOT NULL REFERENCES product (id) ON DELETE CASCADE, \"qty_delta\" INTEGER NOT NULL, \"reason\" TEXT NOT NULL, \"note\" TEXT NULL, \"audit_session_id\" INTEGER NULL, \"batch_id\" INTEGER NULL, \"supplier_id\" INTEGER NULL REFERENCES supplier (id) ON DELETE SET NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
